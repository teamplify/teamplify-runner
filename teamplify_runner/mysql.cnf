[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
mysql_native_password = ON
collation-server = utf8mb4_0900_as_cs
init-connect = 'SET NAMES utf8mb4'
character-set-server = utf8mb4
range_optimizer_max_mem_size = 16777216
host_cache_size = 0
skip-name-resolve
